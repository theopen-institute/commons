[
 {
  "doctype": "Custom Field",
  "name": "Website Settings-website_button_url",
  "owner": "Administrator",
  "is_system_generated": 1,
  "dt": "Website Settings",
  "fieldname": "website_button_url",
  "label": "Website Button Target",
  "fieldtype": "Data",
  "options": "URL",
  "insert_after": "home_page",
  "description": "Where the <b>Website</b> button in the desk sidebar and the Commons sidebar opens. An absolute URL (<code>https://example.org</code>) or a path on this site (<code>/about</code>). Leave blank to open the site root. This does <b>not</b> change where anyone lands after logging in — that is Home Page above, together with the Home Page on each Role."
 },
 {
  "doctype": "Custom Field",
  "name": "Role-home_page_priority",
  "owner": "Administrator",
  "is_system_generated": 1,
  "dt": "Role",
  "fieldname": "home_page_priority",
  "label": "Home Page Priority",
  "fieldtype": "Int",
  "insert_after": "home_page",
  "default": "0",
  "description": "Which Home Page wins when someone holds several roles that each name one. <b>Lowest number wins</b>; roles on the same number are settled by name, so the order is always the same on every site and every login. Only meaningful alongside Home Page above. <b>Has no effect unless Enable Home Page Priority is ticked in Commons Settings.</b>"
 },
